{
  "name": "north-star-local",
  "version": "0.1.0",
  "main": "server.mjs",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --check server.mjs",
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test *.test.mjs public/*.test.mjs scripts/*.test.mjs",
    "quality": "node scripts/check-question-quality.mjs",
    "quality:release": "node scripts/check-question-quality.mjs --release",
    "quality:packet": "node scripts/check-question-quality.mjs --packet",
    "verify": "npm test && npm run quality",
    "family:invite": "node scripts/create-family-code.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0"
  }
}
