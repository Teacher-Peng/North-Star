# Optional: required only for Realtime voice. Keep the real key in .env.local.
OPENAI_API_KEY=

# Local development stays loopback-only without family login.
# Hosted deployment: set NODE_ENV=production, PUBLIC_ORIGIN=https://ailearning.com.tw,
# FAMILY_AUTH_MODE=family, and let the host supply PORT.
# To test family login locally use http://localhost:5176 with PORT=5176,
# BIND_HOST=127.0.0.1 and FAMILY_AUTH_MODE=family.
PUBLIC_ORIGIN=
FAMILY_AUTH_MODE=
# Generate private invitations with npm run family:invite -- family-id "Family label".
# Server configuration contains id, label and hash only; never the original code.
FAMILY_ACCESS_CODES=[]
# Hosted subscription login is OFF until public-origin eligibility is verified.
# Local development keeps the existing flow unless explicitly set to false.
CHATGPT_LOGIN_ENABLED=
